{
  "name": "fangcun-food-and-table",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "方寸食光 · Food & Table — Minecraft Bedrock Add-On",
  "scripts": {
    "compile": "node tools/generate-surfaces.mjs && tsc -p tsconfig.json",
    "build": "npm run compile && node tools/build.mjs",
    "test": "npm run compile && node --test tests/*.test.mjs",
    "check": "npm run build && node tools/validate.mjs",
    "package": "npm run check && npm test && node tools/package.mjs"
  },
  "devDependencies": {
    "@minecraft/server": "2.0.0",
    "@minecraft/server-ui": "2.0.0",
    "@minecraft/vanilla-data": "1.26.52",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.15"
  }
}
